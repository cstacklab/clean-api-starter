@CleanApiStarter_Api_HostAddress = https://localhost:7285
@AccessToken = paste-api-jwt-here

GET {{CleanApiStarter_Api_HostAddress}}/api/words?limit=20&offset=0
Accept: application/json
Authorization: Bearer {{AccessToken}}

###

POST {{CleanApiStarter_Api_HostAddress}}/api/auth/google
Content-Type: application/json

{
  "idToken": "paste-google-id-token-here"
}

###

GET {{CleanApiStarter_Api_HostAddress}}/api/auth/me
Accept: application/json
Authorization: Bearer {{AccessToken}}

###

POST {{CleanApiStarter_Api_HostAddress}}/api/words
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

{
  "text": "observable",
  "meaning": "Able to be noticed, measured, or monitored.",
  "synonyms": ["visible", "measurable"],
  "usageExample": "OpenTelemetry makes API behavior observable."
}

###

GET {{CleanApiStarter_Api_HostAddress}}/api/words?limit=20&offset=0
Accept: application/json
X-Api-Version: 2.0
Authorization: Bearer {{AccessToken}}

###

DELETE {{CleanApiStarter_Api_HostAddress}}/api/words/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{AccessToken}}

###
